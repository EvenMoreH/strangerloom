# Rendered by the nginx image's envsubst at start: ${FRAME_ANCESTORS} is replaced, everything else is kept.
# Hashed build assets are immutable. index.html, sw.js and the manifest are revalidated on every load.
map $uri $cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";
    default     "no-cache";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    include /etc/nginx/mime.types;
    types { application/manifest+json webmanifest; }

    gzip on;
    gzip_types text/css text/javascript application/javascript application/manifest+json image/svg+xml application/json;

    add_header Cache-Control $cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "frame-ancestors ${FRAME_ANCESTORS}" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
