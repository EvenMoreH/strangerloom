# Copy to .env next to compose.yml; docker compose reads it. All values are optional.

# Port published on the Docker host.
HOST_PORT=8080

# Origins allowed to show the app inside a frame, space separated, e.g. "https://tallyho.example.com".
# 'none' (in double quotes, as below) allows no frame.
FRAME_ANCESTORS="'none'"

# Base path the app is built for, with a leading and a trailing slash, e.g. /strangerloom/. Read by npm run build;
# the Docker image takes it as the build argument of the same name.
# VITE_BASE_PATH=/
